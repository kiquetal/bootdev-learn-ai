{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    // Shell commands require approval; the specific rules below are allowed.
    { "action": "shell", "resource": "*", "effect": "ask" },
    // Boot.dev lessons are run with this CLI command.
    { "action": "shell", "resource": "bootdev run *", "effect": "allow" },
    // The run_slop plugin tool executes SlopLang programs with Sloperator.
    { "action": "run_slop", "resource": "*", "effect": "allow" }
  ]
}
