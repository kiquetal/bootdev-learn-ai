{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash-lite",
  "providers": {
    "google": {
      "models": {
        "gemini-3.5-flash-lite": {
          "settings": {
            "temperature": 0.1
          }
        }
      }
    }
  },
  "permissions": [
    // Shell commands require approval; the specific rules below are allowed.
    { "action": "shell", "resource": "*", "effect": "ask" },
    // Boot.dev lessons are run with this CLI command.
    { "action": "shell", "resource": "bootdev run *", "effect": "allow" },
    // The run_slop plugin tool executes SlopLang programs with Sloperator.
    { "action": "run_slop", "resource": "*", "effect": "allow" },
    // The explore subagent is not permitted in this project.
    { "action": "subagent", "resource": "explore", "effect": "deny" }
  ]
}
